{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": {
        "noBannedTypes": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noArguments": "error"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "warn",
        "noNextAsyncClientComponent": "warn",
        "noUnusedImports": "error",
        "noUnusedVariables": "warn",
        "useInlineScriptId": "error",
        "noChildrenProp": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error",
        "noConstAssign": "off",
        "noGlobalObjectCalls": "off",
        "noInvalidBuiltinInstantiation": "off",
        "noInvalidConstructorSuper": "off",
        "noSetterReturn": "off",
        "noUndeclaredVariables": "off",
        "noUnreachable": "off",
        "noUnreachableSuper": "off"
      },
      "performance": {
        "noImgElement": "warn",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "warn",
        "useGoogleFontPreconnect": "warn"
      },
      "style": {
        "noCommonJs": "error",
        "noHeadElement": "warn",
        "noNamespace": "error",
        "noNestedTernary": "off",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "off",
        "useConst": "error",
        "useSpreadOverApply": "error"
      },
      "suspicious": {
        "noDocumentImportInPage": "error",
        "noDuplicateEnumValues": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noHeadImportInDocument": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noTsIgnore": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnusedExpressions": "off",
        "useGoogleFontDisplay": "warn",
        "useNamespaceKeyword": "error",
        "noCommentText": "error",
        "noDuplicateJsxProps": "error",
        "noUnknownAttribute": "off",
        "noClassAssign": "off",
        "noDuplicateClassMembers": "off",
        "noDuplicateObjectKeys": "off",
        "noDuplicateParameters": "off",
        "noFunctionAssign": "off",
        "noImportAssign": "off",
        "noRedeclare": "off",
        "noUnsafeNegation": "off",
        "noVar": "error",
        "noWith": "off",
        "useGetterReturn": "off"
      },
      "a11y": {
        "noAriaUnsupportedElements": "warn",
        "useAltText": "warn",
        "useAriaPropsForRole": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useValidAriaProps": "warn",
        "useValidAriaValues": "warn"
      },
      "nursery": {
        "noReactStringRefs": "error"
      },
      "security": {
        "noBlankTarget": "off",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/out",
      "!!**/next-env.d.ts",
      "!!public",
      "!!lib",
      "!!bun.lock"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
